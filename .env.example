# Karuna · environment template
# Copy to .env.local for local dev.

# Where the backend lives. Leave blank for the in-memory demo.
VITE_API_BASE=

# WhatsApp Business — used by the server, but you may want to expose
# the helpline number to the front-end for click-to-chat.
VITE_HELPLINE_E164=+919697887888

# Razorpay key (publishable) — used by the donate flow at checkout.
VITE_RAZORPAY_KEY=

# Optional Sentry / error tracking
VITE_SENTRY_DSN=
