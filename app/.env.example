# Karuna · environment template — copy to .env.local

# Supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Razorpay (publishable / key_id only — secret stays on the server)
VITE_RAZORPAY_KEY_ID=

# Default org slug for local dev (lets you skip the org picker)
VITE_DEV_ORG_SLUG=awcs

# Sentry — leave empty in dev; set in Vercel for prod
VITE_SENTRY_DSN=
VITE_APP_VERSION=0.1.0

# Cloudflare Turnstile (CAPTCHA on the public report form)
# Leave empty in dev — the widget falls back to a 'dev-skip' token and the
# Edge Function skips verification when TURNSTILE_SECRET_KEY is also unset.
VITE_TURNSTILE_SITEKEY=
